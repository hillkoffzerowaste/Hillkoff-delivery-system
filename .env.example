NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google + OTP login
# Enable Google provider in Firebase Authentication.
# OTP_DEV_MODE=true returns the 6-digit OTP in the API response for local Chrome testing only.
OTP_DEV_MODE=false
ADMIN_EMAIL_ALLOWLIST=

# Optional Google Apps Script Web App URL for vehicle mileage and fuel bill sync.
# Expected actions: upsertDailyMileage, appendFuelBill.
GOOGLE_MILEAGE_WEB_APP_URL=

# Optional OTP email delivery. Gmail app passwords work with smtp.gmail.com.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# LINE Official Account
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# User ID, group ID, or room ID used by server-side push notifications.
LINE_DEFAULT_TO=

# App login PIN (server-side). Set either APP_LOGIN_PIN for both roles,
# or set role-specific pins below.
APP_LOGIN_PIN=
APP_LOGIN_PIN_SALES=
APP_LOGIN_PIN_DRIVER=
