{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "apphosting": [
    {
      "backendId": "delivery-system",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".vercel",
        "outputs",
        "functions",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".env*"
      ]
    }
  ]
}
